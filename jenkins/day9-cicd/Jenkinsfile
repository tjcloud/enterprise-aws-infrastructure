pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Project') {
            steps {
                sh '''
                    set -eu
                    test -f hello_cloud.py
                    test -f docker/day6-python-app/Dockerfile
                    grep -q "CLOUD ENGINEERING PROJECT 1" hello_cloud.py
                    echo "Project validation passed."
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                      -f docker/day6-python-app/Dockerfile \
                      -t hello-cloud:day9 \
                      .
                '''
            }
        }

        stage('Run and Verify Container') {
            steps {
                sh '''
                    set -eu
                    output="$(docker run --rm hello-cloud:day9)"
                    printf '%s\\n' "$output"
                    printf '%s\\n' "$output" | grep -q "CLOUD ENGINEERING PROJECT 1"
                    printf '%s\\n' "$output" | grep -q "AWS Cost: \\$0"
                    echo "Container verification passed."
                '''
            }
        }
    }

    post {
        success {
            echo 'CI/CD pipeline completed successfully.'
        }
        failure {
            echo 'CI/CD pipeline failed. Review the stage logs.'
        }
    }
}
